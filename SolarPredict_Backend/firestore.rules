rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // User-scoped data: only the owner can read/write their subtree.
    // Anonymous Firebase users also pass `request.auth != null`, so guest
    // accounts that get linked to a real account keep their data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
